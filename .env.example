# ===== LLM =====
# openai | anthropic
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=

# ===== 임베딩 =====
# openai | local (local은 sentence-transformers 추가 설치 필요)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# ===== 벡터 DB =====
CHROMA_DIR=./.chroma
COLLECTION_NAME=jinsang
DATA_PATH=./data/jinsang_cases.jsonl

# ===== RAG 파라미터 =====
TOP_K=3
MAX_HISTORY=12
MAX_TOKENS=300
TEMPERATURE=0.9
